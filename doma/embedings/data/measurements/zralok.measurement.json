  "source_segments": [
    {
      "id": "01",
      "label": "Karta: images/zralok.jpg Text: NAD : POD 1 : 1",
      "text": "Karta: images/zralok.jpg\n\nText: NAD : POD 1 : 1\n\nO ŽRALOKOVI\n\nkterý měl poměr\n\n—\n\nnad : pod = 1 : 1\n\n—",
      "characters": 102,
      "words": 13
    },
    {
      "id": "02",
      "label": "Zní to jako rovnice, ale zároveň jako hádanka. Žralok",
      "text": "Zní to jako rovnice, ale zároveň jako hádanka. Žralok je tvor, co se tváří, že je dole, ale občas se vynoří. Nad hladinou je jen na chvíli, pod ní je doma. A přesto — poměr je 1:1. Jako kdyby to, co je vidět, bylo stejně důležité jako to, co není.",
      "characters": 247,
      "words": 47
    },
    {
      "id": "03",
      "label": "— Žralok žil pod vodou. To se ví. Tam",
      "text": "—\n\nŽralok žil pod vodou.\n\nTo se ví.\n\nTam je doma.\n\nTam je klid.\n\nTam se neptá nikdo na nic.\n\n—\n\nAle jednou za čas se vynořil.\n\nJen na chvíli.",
      "characters": 141,
      "words": 28
    },
    {
      "id": "04",
      "label": "Jen na nádech. Jen na pohled. — A pokaždé,",
      "text": "Jen na nádech.\n\nJen na pohled.\n\n—\n\nA pokaždé, když se vynořil, někdo ho uviděl.\n\nA řekl:\n\n„Žralok! Pozor!“\n\n„Nebezpečí!“\n\n„Zuby!“",
      "characters": 129,
      "words": 18
    },
    {
      "id": "05",
      "label": "A žralok se zase ponořil. Pod hladinu. Do ticha.",
      "text": "A žralok se zase ponořil.\n\nPod hladinu.\n\nDo ticha.\n\nDo místa, kde nikdo nekřičí.\n\n—\n\nAle začal si počítat.\n\nKolikrát je nad.\n\nKolikrát je pod.",
      "characters": 142,
      "words": 23
    },
    {
      "id": "06",
      "label": "A zjistil: 1 : 1 — Jednou nahoře. Jednou",
      "text": "A zjistil:\n\n1 : 1\n\n—\n\nJednou nahoře.\n\nJednou dole.\n\nJednou viděn.\n\nJednou skryt.\n\n—\n\n„To je spravedlivé,“ řekl si.\n\n„To je rovnováha.“\n\n„To je život.“\n\n—",
      "characters": 153,
      "words": 20
    },
    {
      "id": "07",
      "label": "Ale pak přišla ryba. Malá. Zvědavá. A zeptala se:",
      "text": "Ale pak přišla ryba.\n\nMalá.\n\nZvědavá.\n\nA zeptala se:\n\n„Proč se vůbec vynořuješ?“\n\n„Aby si mě všimli,“ řekl žralok.\n\n„Aby věděli, že jsem.“",
      "characters": 138,
      "words": 22
    },
    {
      "id": "08",
      "label": "„Ale pak se bojí,“ řekla ryba. „To je jejich",
      "text": "„Ale pak se bojí,“ řekla ryba.\n\n„To je jejich věc,“ řekl žralok.\n\n„Já jsem jen poměr.“\n\n—\n\nRyba si to zapsala.\n\nDo bubliny.\n\nDo kruhu na vodě.",
      "characters": 142,
      "words": 26
    },
    {
      "id": "09",
      "label": "Do paměti. — A pak se zeptala: „A co",
      "text": "Do paměti.\n\n—\n\nA pak se zeptala:\n\n„A co kdyby ses vynořil dvakrát?“\n\n„Pak bych byl víc nad než pod,“ řekl žralok.\n\n„A to už nejsem já.“\n\n—",
      "characters": 138,
      "words": 23
    },
    {
      "id": "10",
      "label": "Od té doby si žralok hlídá poměr. Jednou nahoře.",
      "text": "Od té doby si žralok hlídá poměr.\n\nJednou nahoře.\n\nJednou dole.\n\nNikdy víc.\n\nNikdy míň.\n\n—\n\nA když ho někdo zahlédne,\n\nje to přesně ten okamžik, co má být.\n\nNe dřív.\n\nNe později.",
      "characters": 178,
      "words": 31
    }
  ],
