  "segments": [
    {
      "id": "l01",
      "text": "Lemur se narodil v koutku.\nV koutku místnosti, v koutku světa, v koutku oka.\nTam, kde se věci obvykle nechávají být.\nTam, kde se neptá.\nTam, kde se neukazuje.",
      "chars": 158,
      "words": 18
    },
    {
      "id": "l02",
      "text": "A tak si řekl:\n„Budu nenápadný.“\n„Budu tak nenápadný, že mě ani moje vlastní stín nepozná.“\n„Budu tak tichý, že i ticho bude hlasité vedle mě.“",
      "chars": 143,
      "words": 14
    },
    {
      "id": "l03",
      "text": "Jenže měl oči jak lampy.\nOcas vztyčený jak vykřičník.\nA srst jako výkladní skříň, co se snaží být tapetou.",
      "chars": 106,
      "words": 14
    },
    {
      "id": "l04",
      "text": "Vedle něj seděla postava.\nKlidná.\nTichá.\nBez barvy.\nBez pohybu.\nBez potřeby být.",
      "chars": 80,
      "words": 10
    },
    {
      "id": "l05",
      "text": "Řekla:\n„Nejlepší je nechat to být. Vše ostatní je moc nápadné.“\nA lemur se snažil.",
      "chars": 82,
      "words": 10
    },
    {
      "id": "l06",
      "text": "Ale oči mu svítily i pod dekou.\nOcas mu trčel i bez svolení.\nA srst mu zářila jako reklama na klid, co bliká.",
      "chars": 109,
      "words": 12
    },
    {
      "id": "l07",
      "text": "„Nejsem nápadný,“ šeptal.\n„Jsem jen… výrazně nenápadný.“\n„Jsem jen… ticho, co má barvy.“\n„Jsem jen… pozadí, co se nedá přehlédnout.“",
      "chars": 132,
      "words": 13
    },
    {
      "id": "l08",
      "text": "Postava vedle něj neřekla nic.\nJen se dívala.\nA to bylo horší než slova.",
      "chars": 72,
      "words": 7
    },
    {
      "id": "l09",
      "text": "Lemur se pokusil být stínem.\nAle jeho stín měl vlastní názor.\nLemur se pokusil být flekem na zdi.\nAle flek ho odmítl, protože byl moc výrazný.",
      "chars": 142,
      "words": 18
    },
    {
      "id": "l10",
      "text": "Nakonec si sedl.\nPřestal se snažit.\nOči mu svítily.\nOcas mu trčel.\nSrst mu zářila.",
      "chars": 82,
      "words": 10
    },
    {
      "id": "l11",
      "text": "A postava vedle něj řekla:\n„Teď jsi konečně neviditelný.“\n„Jak to?“ zeptal se lemur.\n„Protože už se nesnažíš.“",
      "chars": 110,
      "words": 12
    },
    {
      "id": "l12",
      "text": "A tak se lemur stal mistrem nenápadnosti.\nNe tím, že zmizel.\nAle tím, že přestal křičet, že nechce být vidět.",
      "chars": 109,
      "words": 12
    },
    {
      "id": "l13",
      "text": "A každý, kdo ho uvidí, řekne:\n„To je ten nenápadný lemur.“\nA pak se tváří, že ho nevidí.\nA to je přesně to, co chtěl.",
      "chars": 117,
      "words": 10
    }
  ],
