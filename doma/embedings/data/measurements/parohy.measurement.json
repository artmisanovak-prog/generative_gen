  "source_segments": [
    {
      "id": "01",
      "label": "Text: 1000x blesk nikdy hrom žádný déšť.",
      "text": "Text: 1000x blesk nikdy hrom žádný déšť. Říkají mi Sýýýr\n\nO PAROZÍCH\n\nkteré sbíraly blesky\n\n—\n\nByl jednou jeden člověk. Nebo jelen. Nebo něco mezi.",
      "characters": 147,
      "words": 24
    },
    {
      "id": "02",
      "label": "Měla parohy. Ale ne obyčejné. Byly to",
      "text": "Měla parohy. Ale ne obyčejné.\n\nByly to bleskosběrné parohy.\n\nNe pro počasí.\n\nPro paměť.\n\n—",
      "characters": 90,
      "words": 14
    },
    {
      "id": "03",
      "label": "Každý den do ni uhodil blesk. Ne",
      "text": "Každý den do ni uhodil blesk.\n\nNe z nebe.\n\nZ foťáku.\n\nZ cvaknutí.\n\nZ „syyyr!“",
      "characters": 77,
      "words": 15
    },
    {
      "id": "04",
      "label": "— Tisíckrát. Blesk. Ale nikdy hrom. Žádný",
      "text": "—\n\nTisíckrát.\n\nBlesk.\n\nAle nikdy hrom.\n\nŽádný déšť.",
      "characters": 51,
      "words": 7
    },
    {
      "id": "05",
      "label": "Jen světlo. A úsměv. A paměť, co",
      "text": "Jen světlo.\n\nA úsměv.\n\nA paměť, co se nikdy neptá, jestli je pravdivá.\n\n—\n\nŘíkali ji Syyyr.",
      "characters": 91,
      "words": 16
    },
    {
      "id": "06",
      "label": "Jako „sýr“, ale s ozvěnou. Protože když",
      "text": "Jako „sýr“, ale s ozvěnou.\n\nProtože když se usmívala, bylo to jako když se slovo snaží být obrazem.\n\nA když se neusmívala, stejně se to vyfotilo.\n\n—\n\nParohy ji rostly pokaždé, když ji někdo vyfotil.",
      "characters": 198,
      "words": 34
    },
    {
      "id": "07",
      "label": "Jedna větev za každou vzpomínku. Jedna zákruta",
      "text": "Jedna větev za každou vzpomínku.\n\nJedna zákruta za každé „syyyr“.\n\nA tak se stala živým albem.\n\nChodila po světě a nosila na hlavě všechny momenty, které nikdo už nechtěl pamatovat.\n\n—",
      "characters": 184,
      "words": 30
    },
    {
      "id": "08",
      "label": "tak chodila tam a sla dal s",
      "text": "tak chodila tam a sla dal\n\ns parohy jako s antenami.\n\nTěžka od světla.\n\nLehka od smyslu.\n\nA když ji někdo potkal, řekl:",
      "characters": 119,
      "words": 23
    },
    {
      "id": "09",
      "label": "„To je ta, co má parohy z",
      "text": "„To je ta, co má parohy z paměti. Ta, co nikdy nezmokne. Ta, co se usmívá, i když neví proč.“\n\n—\n\npOd té doby se říká, že když tě někdo vyfotí a wty se usměješ,\n\nmožná se ti právě začíná klubat nový paroh.\n\n—",
      "characters": 208,
      "words": 42
    },
    {
      "id": "10",
      "label": "A že „syyyr“ není jen zvuk. Je",
      "text": "A že „syyyr“ není jen zvuk.\n\nJe to stopa reci v obraze.\n\nJe to blesk bez bouřky.\n\nJe to paměť, co se tváří jako přítomnost.",
      "characters": 123,
      "words": 25
    }
  ],
