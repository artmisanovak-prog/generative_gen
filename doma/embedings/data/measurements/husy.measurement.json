  "segments": [
    {
      "id": "01",
      "label": "O HUSÁCH které mluvily „já ja jajaja jaja ja“",
      "text": "O HUSÁCH\n\nkteré mluvily „já ja jajaja jaja ja“\n\nNa severu, kde se slova lámou o vítr a příběhy se rodí z mlhy, žilo jedno hejno hus.\n\nVelkých.\n\nBílých",
      "characters": 150,
      "words": 25
    },
    {
      "id": "02",
      "label": "Obyčejných. Aspoň podle svého mínění. A mínění, těch měly",
      "text": "Obyčejných.\n\nAspoň podle svého mínění.\n\nA mínění, těch měly zásoby bez dna.",
      "characters": 75,
      "words": 11
    },
    {
      "id": "03",
      "label": "A to si tyhlety konkrétní husy si to kompenzovaly",
      "text": "A to si tyhlety konkrétní husy si to kompenzovaly tím , že dělaly slovní nosičky.\n\nJenže..\n\nKaždá z nich nesla jedno „já“.",
      "characters": 122,
      "words": 19
    },
    {
      "id": "04",
      "label": "A žádny z tech všech „já“ si nebylo jisté,",
      "text": "A žádny z tech všech „já“ si nebylo jisté, jestli je opravdu „já“, nebo jen ozvěna jiného „já“.\n\nA tak husy nelétaly v klínu.\n\nLétaly v kruhu.\n\nA křičely:",
      "characters": 154,
      "words": 23
    },
    {
      "id": "05",
      "label": "„Já ja jajaja jaja ja!“ Ti, kdo je slyšely",
      "text": "„Já ja jajaja jaja ja!“\n\nTi, kdo je slyšely z nich byly polopopletení.\n\nJedni si mysleli, že je to zpěv.\n\ndruzí, že je to porucha.",
      "characters": 130,
      "words": 24
    },
    {
      "id": "06",
      "label": "Ale ve skutečnosti to byl - manifest identity v",
      "text": "Ale ve skutečnosti to byl - manifest identity v rozkladu.\n\nJedna husa, jmenovala se asi Já, možná JáJá, se jednou zastavila a řekla:",
      "characters": 132,
      "words": 20
    },
    {
      "id": "07",
      "label": "„Já jsem já, ale jen když ja slyšíš. Když",
      "text": "„Já jsem já, ale jen když ja slyšíš. Když ja neslyšíš, jsem jen jaja. A když mě slyšíš moc, jsem jajaja. A když mě slyšíš pořád, jsem jaja ja. A pak už nevím, kdo jsem.“",
      "characters": 169,
      "words": 32
    },
    {
      "id": "08",
      "label": "Ostatní husy přikyvovaly krky jako v opravdové panice. „Já",
      "text": "Ostatní husy přikyvovaly krky jako v opravdové panice.\n\n„Já ja jajaja jaja ja!“\n\nTo nebyl výkřik.\n\nTo byla gramatická krize.\n\nJednou přiletěl houser.\n\nUnavený, potrhaný, s kufrem plným zájmu.\n\nZeptal se:",
      "characters": 203,
      "words": 29
    },
    {
      "id": "09",
      "label": "„Kdo jste?“ A husy odpověděly: „Já.“ „Já.“ „Já.“ „Já.“",
      "text": "„Kdo jste?“\n\nA husy odpověděly:\n\n„Já.“\n\n„Já.“\n\n„Já.“\n\n„Já.“\n\n„Já.“\n\n„Já.“\n\n„Já ja jajaja jaja ja.“\n\nHouser se zasmál.\n\n„Aha. Kolektivní singular. To znám.“\n\nVíc nic nedodal.\n\nA odletěl.\n\nA neřekl kam.",
      "characters": 200,
      "words": 29
    },
    {
      "id": "10",
      "label": "Od té doby se říká, že když někdo opakuje",
      "text": "Od té doby se říká, že když někdo opakuje „já“ tak dlouho, až to zní jako „jajaja“, možná nehledá pozornost.\n\nMožná hledá bílé husy.\n\nMožná jejich já neslyšel.\n\nHusty totiz nejsou hloupé.\n\nJsou jen hlasité pokusy o sebe-klam.",
      "characters": 225,
      "words": 38
    }
  ],
