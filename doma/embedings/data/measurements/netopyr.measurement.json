  "source_segments": [
    {
      "id": "01",
      "label": "O NETOPÝROVI a krása která ráno se",
      "text": "O NETOPÝROVI\n\na krása která ráno se [už] nehodí\n\nNetopýr žil v noci.\n\nNe jen fyzicky.\n\nEsteticky.",
      "characters": 97,
      "words": 17
    },
    {
      "id": "02",
      "label": "Filozoficky. V noci bylo všechno správně. Stíny",
      "text": "Filozoficky.\n\nV noci bylo všechno správně.\n\nStíny měly tvar.\n\nZvuky měly smysl.\n\nLidé byli krásní, protože nebyli vidět.",
      "characters": 120,
      "words": 18
    },
    {
      "id": "03",
      "label": "Každý večer se probudil, natáhl křídla, protáhl",
      "text": "Každý večer se probudil, natáhl křídla, protáhl zobák a vyletěl.\n\nNe za potravou.\n\nZa atmosférou.\n\nZa tím, co se děje jenom ve chvílích, kdy svět zapomene na pravidla.\n\nLetěl nad městem, kde se světla třpytila jako sliby.",
      "characters": 221,
      "words": 37
    },
    {
      "id": "04",
      "label": "A všechno bylo možné. Všechno bylo krásné.",
      "text": "A všechno bylo možné.\n\nVšechno bylo krásné.\n\nVšechno bylo trochu nepravdivé – ale o dost pravdivější.\n\nA pak přišlo ráno.",
      "characters": 121,
      "words": 19
    },
    {
      "id": "05",
      "label": "A všechno se nehodilo. Tváře, co v",
      "text": "A všechno se nehodilo.\n\nTváře, co v noci zářily, byly najednou unavené.\n\nSlova, co zněla jako poezie, se změnila v trapné poznámky.\n\nDoteky, co vibrovaly, se změnily v rozpaky.\n\nA netopýr se schoval.",
      "characters": 199,
      "words": 33
    },
    {
      "id": "06",
      "label": "Do stropu. Do tmy. Do snu. „V",
      "text": "Do stropu.\n\nDo tmy.\n\nDo snu.\n\n„V noci krása, co ráno už se nehodí,“ šeptal si.\n\nA nebyl v tom sám.",
      "characters": 98,
      "words": 21
    },
    {
      "id": "07",
      "label": "Všichni, kdo v noci žili, to znali.",
      "text": "Všichni, kdo v noci žili, to znali.\n\nBásníci.\n\nBarmani.\n\nZtracenci.",
      "characters": 67,
      "words": 10
    },
    {
      "id": "08",
      "label": "Zamilovaní. A ti, co si ráno říkají:",
      "text": "Zamilovaní.\n\nA ti, co si ráno říkají:\n\n„Tohle jsem neřekl.\n\nTohle jsem necítil.\n\nTohle jsem nebyl.“",
      "characters": 99,
      "words": 16
    },
    {
      "id": "09",
      "label": "Ale netopýr věděl, že byl. Že noc",
      "text": "Ale netopýr věděl, že byl.\n\nŽe noc není lež.\n\nJe to jiný jazyk.\n\nJiný smysl.\n\nJiný druh pravdy, která se nehodí do denního světla.",
      "characters": 130,
      "words": 24
    },
    {
      "id": "10",
      "label": "A tak se začalo říkat, že netopýr",
      "text": "A tak se začalo říkat, že netopýr je tvor, který nosí krásu, co se nehodí.\n\nA že jeho pohádky jsou jako kocovina.\n\nBolí.\n\nAle připomínají, že jsme žili.",
      "characters": 152,
      "words": 28
    }
  ],
