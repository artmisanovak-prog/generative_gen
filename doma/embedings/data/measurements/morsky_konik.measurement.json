  "source_segments": [
    {
      "id": "01",
      "label": "🪸 O MOŘSKÉM KONÍKOVI neposlaná zpráva, probdělý sen, pointa",
      "text": "🪸 O MOŘSKÉM KONÍKOVI\n\nneposlaná zpráva, probdělý sen, pointa nesmyslů, zbytečný důvod\n\nKdysi dávno — ale zároveň přesně tehdy, kdy jsi to nečekala — žil jeden mořský koník.\n\nNebyl velký. Nebyl malý. Nebyl ani rychlý, ani pomalý.",
      "characters": 229,
      "words": 33
    },
    {
      "id": "02",
      "label": "Byl přesně takový, jaký musí být tvor, který se",
      "text": "Byl přesně takový, jaký musí být tvor, který se celý život tváří, že je figurka na dně akvária, i když ve skutečnosti nese v hlavě mapu všech nesmyslů světa.\n\nMořský koník měl zvláštní zvyk:\n\npsal zprávy, které nikdy neodeslal.",
      "characters": 227,
      "words": 37
    },
    {
      "id": "03",
      "label": "Ne do lahve. Ne do písku. Ne do proudu.",
      "text": "Ne do lahve.\n\nNe do písku.\n\nNe do proudu.\n\nPsával je do bublin.\n\nA bubliny praskaly dřív, než se kdokoli dozvěděl, co v nich bylo.\n\nA tak se z nich staly neposlané zprávy.",
      "characters": 171,
      "words": 29
    },
    {
      "id": "04",
      "label": "A z koníka se stal někdo, kdo má plnou",
      "text": "A z koníka se stal někdo, kdo má plnou hlavu slov, která nikdo nikdy neuslyší.\n\n---\n\n🌙 Probdělý sen\n\nJednou v noci — nebo to byl den, jen přikrytý tmou? — se mořskému koníkovi zdál sen.",
      "characters": 186,
      "words": 29
    },
    {
      "id": "05",
      "label": "Ale protože koníci neumějí spát, byl to vlastně probdělý",
      "text": "Ale protože koníci neumějí spát, byl to vlastně probdělý sen.\n\nTakový ten, co se ti stane, když jsi tak unavený, že nevěříš, že bys usl.\n\nV tom snu se koník ocitl na hladině.\n\nNe na dně.\n\nNe v proudu.\n\nNa hladině.\n\nA tam uviděl kruhy.\n\nKruhy po něčem, co dopadlo.",
      "characters": 263,
      "words": 47
    },
    {
      "id": "06",
      "label": "Po něčem, co nebylo vidět. Po něčem, co se",
      "text": "Po něčem, co nebylo vidět.\n\nPo něčem, co se nedalo vzít zpět.\n\nA koník si řekl:\n\n„Tohle je stopa po něčem, co jsem neudělal.“\n\nA to ho vyděsilo víc než cokoliv jiného.\n\n---\n\n🔄 Pointa nesmyslů\n\nMořský koník byl mistr v nesmyslech.",
      "characters": 230,
      "words": 37
    },
    {
      "id": "07",
      "label": "Ne že by je vymýšlel — on je sbíral.",
      "text": "Ne že by je vymýšlel — on je sbíral.\n\nJako jiní sbírají mušle.\n\nKaždý nesmysl měl svůj tvar.\n\nJeden byl hranatý.\n\nJeden byl měkký.\n\nJeden byl tak ostrý, že se o něj dalo říznout.\n\nA koník je skládal do sebe, až z nich vznikla pointa.",
      "characters": 233,
      "words": 41
    },
    {
      "id": "08",
      "label": "Ale pointa byla tak nesmyslná, že dávala smysl jen",
      "text": "Ale pointa byla tak nesmyslná, že dávala smysl jen jemu.\n\nZněla takto:\n\n„Když nevíš proč, udělej to stejně.\n\nZbytečný důvod je pořád důvod.“\n\nA to byla věta, kterou si koník nikdy nahlas neřekl.\n\nJen ji nosil v sobě jako kost, která se nedá spolknout ani vyplivnout.\n\n---",
      "characters": 271,
      "words": 44
    },
    {
      "id": "09",
      "label": "🐴 Zbytečný důvod A tak se stalo, že jednoho",
      "text": "🐴 Zbytečný důvod\n\nA tak se stalo, že jednoho dne — nebo noci, nebo mezi tím — se mořský koník rozhodl něco udělat.\n\nNe kvůli odvaze.\n\nNe kvůli strachu.\n\nNe kvůli smyslu.\n\nAle kvůli zbytečnému důvodu.\n\nVyplaval nahoru.\n\nA tam, na hladině, napsal poslední zprávu.\n\nNe do bubliny.\n\nDo vlny.",
      "characters": 288,
      "words": 45
    },
    {
      "id": "10",
      "label": "A ta zpráva zněla: „Tohle jsem ti chtěl říct",
      "text": "A ta zpráva zněla:\n\n„Tohle jsem ti chtěl říct už dávno.\n\nAle neposlal jsem to.\n\nTak to nechám tady.“\n\nA vlna ji vzala.\n\nA nikdo ji nepřečetl.\n\nA přesto ji každý cítil.\n\nProtože některé zprávy nejsou pro oči.\n\nJsou pro vodu.\n\nA mořský koník se vrátil na dno.\n\nA nic se nezměnilo.\n\nA přesto bylo všechno jinak.",
      "characters": 308,
      "words": 50
    }
  ],
