  "source_segments": [
    {
      "id": "01",
      "label": "Karta: images/hvezdice.jpg Text: kruhy na vodě jsou jizvy po",
      "text": "Karta: images/hvezdice.jpg\n\nText: kruhy na vodě jsou jizvy po kamenech\n\nO MOŘSKÉ HVĚZDICI\n\nKruhy na vodě jsou jizvy po kamenech",
      "characters": 127,
      "words": 21
    },
    {
      "id": "02",
      "label": "Mořská hvězdice ležela na dně. Tichá. Plochá. Nerozhodná. Nad",
      "text": "Mořská hvězdice ležela na dně.\n\nTichá.\n\nPlochá.\n\nNerozhodná.\n\nNad ní se voda vlnila.\n\nKruhy se šířily.\n\nJeden za druhým.\n\nDokonalé.\n\nPomíjivé.\n\nKrásné.",
      "characters": 151,
      "words": 22
    },
    {
      "id": "03",
      "label": "„To je poezie,“ řekla ryba, co rapuje proudem. „To",
      "text": "„To je poezie,“ řekla ryba, co rapuje proudem.\n\n„To je geometrie,“ řekla chobotnice, co improvizuje jazz.",
      "characters": 105,
      "words": 16
    },
    {
      "id": "04",
      "label": "„To je náhoda,“ řekla medúza, co hraje na triangl.",
      "text": "„To je náhoda,“ řekla medúza, co hraje na triangl.\n\nAle hvězdice mlčela.\n\nA pak řekla:\n\n„Ne. To jsou jizvy.“\n\n„Jizvy?“\n\n„Po kamenech.“",
      "characters": 134,
      "words": 21
    },
    {
      "id": "05",
      "label": "„Po věcech, co dopadly.“ „Po rozhodnutích, co se nedaly",
      "text": "„Po věcech, co dopadly.“\n\n„Po rozhodnutích, co se nedaly vzít zpět.“\n\nKaždý kruh začínal nárazem.\n\nKámen.\n\nKapka.\n\nPád.\n\nA pak se šířil.\n\nDo dálky.",
      "characters": 147,
      "words": 23
    },
    {
      "id": "06",
      "label": "Do šířky. Do jiných životů. „Ale vždyť se voda",
      "text": "Do šířky.\n\nDo jiných životů.\n\n„Ale vždyť se voda zase uklidní,“ řekla sova, co přiletěla omylem.\n\n„Ano,“ řekla hvězdice.",
      "characters": 120,
      "words": 19
    },
    {
      "id": "07",
      "label": "„Ale to neznamená, že se nic nestalo.“ Mořská hvězdice",
      "text": "„Ale to neznamená, že se nic nestalo.“\n\nMořská hvězdice znala dno.\n\nZnala ticho po dopadu.\n\nZnala chvíli, kdy se kámen dotkne písku\n\na už není jen kámen —",
      "characters": 154,
      "words": 26
    },
    {
      "id": "08",
      "label": "je vzpomínka. „A co s tím?“ ptala se myš,",
      "text": "je vzpomínka.\n\n„A co s tím?“ ptala se myš, co zapisuje do skulin.\n\n„Nic,“ řekla hvězdice.\n\n„Jen to vidět.\n\nJen to vědět.\n\nJen to neplést s krásou.“",
      "characters": 147,
      "words": 24
    },
    {
      "id": "09",
      "label": "A tak se začalo říkat, že někde na dně",
      "text": "A tak se začalo říkat,\n\nže někde na dně žije hvězdice,\n\nkterá ví, že kruhy na vodě nejsou jen obraz.\n\nJsou to jizvy.\n\nPo kamenech.\n\nPo slovech.\n\nPo činech.",
      "characters": 155,
      "words": 28
    },
    {
      "id": "10",
      "label": "A že když vidíš kruh, můžeš se ptát: „Co",
      "text": "A že když vidíš kruh,\n\nmůžeš se ptát:\n\n„Co dopadlo?“\n\n„Co se změnilo?“\n\n„Co už nejde vzít zpět?“\n\nA možná zjistíš,\n\nže i ticho má paměť.\n\nA že voda si pamatuje všechno.\n\nI když to neřekne.",
      "characters": 188,
      "words": 31
    }
  ],
