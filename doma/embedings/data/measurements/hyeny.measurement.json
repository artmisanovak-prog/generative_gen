  "source_segments": [
    {
      "id": "01",
      "label": "O HYENÁCH Hyeny se nikdy nepřestanou smát. Hyeny se",
      "text": "O HYENÁCH\n\nHyeny se nikdy nepřestanou smát.\n\nHyeny se smějí.\n\nVždycky.\n\nNe proto, že by chtěly.\n\nAle protože musí.",
      "characters": 114,
      "words": 18
    },
    {
      "id": "02",
      "label": "Smích je jejich jazyk. Jejich zbraň. Jejich výmluva. Smějí",
      "text": "Smích je jejich jazyk.\n\nJejich zbraň.\n\nJejich výmluva.\n\nSmějí se, když přijdou.\n\nSmějí se, když odejdou.\n\nSmějí se, když mlčí.",
      "characters": 126,
      "words": 20
    },
    {
      "id": "03",
      "label": "Smějí se, když se bojíš. A každý si myslí,",
      "text": "Smějí se, když se bojíš.\n\nA každý si myslí, že je to veselí.\n\nAle není.\n\nJe to ozvěna.\n\nJe to obrana.",
      "characters": 101,
      "words": 20
    },
    {
      "id": "04",
      "label": "Je to způsob, jak neříct, co se opravdu děje.",
      "text": "Je to způsob, jak neříct, co se opravdu děje.\n\nJedna hyena se jednou pokusila přestat.\n\nZavřela tlamu.\n\nZadržela dech.\n\nZtichla.",
      "characters": 128,
      "words": 20
    },
    {
      "id": "05",
      "label": "A svět se zarazil. Ostatní hyeny se na ni",
      "text": "A svět se zarazil.\n\nOstatní hyeny se na ni podívaly.\n\nA začaly se smát ještě víc.\n\nNe proto, že by to bylo vtipné.",
      "characters": 114,
      "words": 21
    },
    {
      "id": "06",
      "label": "Ale protože ticho je nebezpečné. Ticho je otázka. Ticho",
      "text": "Ale protože ticho je nebezpečné.\n\nTicho je otázka.\n\nTicho je zrcadlo.\n\nA tak se ta hyena znovu rozesmála.\n\nNahlas.\n\nFalešně.\n\nAle bezpečně.",
      "characters": 139,
      "words": 21
    },
    {
      "id": "07",
      "label": "Od té doby se ví: Hyeny se nikdy nepřestanou",
      "text": "Od té doby se ví:\n\nHyeny se nikdy nepřestanou smát.\n\nProtože smích je stěna.\n\nA za tou stěnou je něco, co se nesmí pustit ven.",
      "characters": 126,
      "words": 24
    },
    {
      "id": "08",
      "label": "A když se smějí, vypadá to jako výsměch. Ale",
      "text": "A když se smějí,\n\nvypadá to jako výsměch.\n\nAle je to prosba.\n\n„Nedívej se moc blízko.“\n\n„Nezastavuj se.“\n\n„Nezvedej otázku.“\n\nA tak běží.\n\nA tak se smějí.",
      "characters": 154,
      "words": 24
    },
    {
      "id": "09",
      "label": "A tak se svět tváří, že je to normální.",
      "text": "A tak se svět tváří, že je to normální.\n\nAle někdy, když je noc dlouhá\n\na vítr se neodváží dýchat,\n\nhyena se zastaví.\n\nA smích se změní.",
      "characters": 136,
      "words": 24
    },
    {
      "id": "10",
      "label": "Na něco, co zní jako pláč. Ale není. Je",
      "text": "Na něco, co zní jako pláč.\n\nAle není.\n\nJe to jen jiný druh smíchu.\n\nA od té doby se říká:\n\n„Hyeny se nikdy nepřestanou smát.\n\nAle to neznamená, že se smějí rády.“",
      "characters": 162,
      "words": 31
    }
  ],
