  "source_segments": [
    {
      "id": "01",
      "label": "Text: až vyrostu budu princeznou + až",
      "text": "Text: až vyrostu budu princeznou + až vyrostu budu TYGR = ❤️\n\nO TYGROVI\n\nTohle je nejen pohádka, ale jazyková alchymie.\n\nNejen proměna, ale překlad přání.\n\nNejen kouzlo, ale chyba v systému tradice, která se ukáže být pravdou.\n\nKde žabí logika narazí na tygří touhu.\n\nKde princezna nepolíbí budoucnost, ale možnost.",
      "characters": 315,
      "words": 48
    },
    {
      "id": "02",
      "label": "Pohádka o princezně, žábě a tygrovi, co",
      "text": "Pohádka o princezně, žábě a tygrovi, co se nevešli do tradice\n\nMalá holka si přála být princeznou.\n\nNic zvláštního.\n\nAle ne kvůli koruně.\n\nJen kvůli příběhu.\n\nKvůli tomu, že princezny líbaj žábu.\n\nA žába se změní na prince.",
      "characters": 223,
      "words": 38
    },
    {
      "id": "03",
      "label": "Tak to má být. Tak se to",
      "text": "Tak to má být.\n\nTak se to říká v knížkách.\n\nTakhle to říkají dospělí.\n\nJenže v rybníčku\n\nsice seděla žába - to jo.\n\nAkorát že ta si přála něco jiného.\n\n„Až vyrostu, budu tygr,“",
      "characters": 176,
      "words": 33
    },
    {
      "id": "04",
      "label": "tvrdila od pulečka. (tenkrat myslela, že přeskočí",
      "text": "tvrdila od pulečka.\n\n(tenkrat myslela, že přeskočí i tu část žáby a stane se tygrem rovnou z pulce - leč - se nestalo tak - až pak)\n\nPrinc? cože - to jí ani nenapadlo.\n\n“Co to je zač?” ptala se.\n\nČlověk?\n\nVýsledek polibku?\n\nČím? Kouzlením?",
      "characters": 239,
      "words": 41
    },
    {
      "id": "05",
      "label": "Chci být Ale zvíře, co se nedá",
      "text": "Chci být\n\nAle zvíře, co se nedá přeložit.\n\nPrincezna se přiblížila.\n\nS pohledem, co věří v kouzla.\n\nS rty, co chtějí změnu.\n\nS očekáváním, co nepočítá s výjimkou.\n\nA žába se zachvěla.",
      "characters": 183,
      "words": 32
    },
    {
      "id": "06",
      "label": "Ne strachem. Ale rozhodnutím. „Když mě políbíš,",
      "text": "Ne strachem.\n\nAle rozhodnutím.\n\n„Když mě políbíš, nezměním se v prince.\n\nZměním se v to, co chci být.\n\nA to je tygr.“\n\n„Ale to se neříká,“ řekla princezna.\n\n„Takhle se to neděje.“",
      "characters": 179,
      "words": 32
    },
    {
      "id": "07",
      "label": "„To se teprve začne dít,“ řekla žába.",
      "text": "„To se teprve začne dít,“ řekla žába.\n\nA tak se to stalo.\n\nDívka a žabák a polibek.\n\nNe jako kouzlo.\n\nAle jako souhlas.\n\nNe jako proměna.\n\nAle jako překlad přání.",
      "characters": 162,
      "words": 30
    },
    {
      "id": "08",
      "label": "A před princeznou nestál princ. Stál tam",
      "text": "A před princeznou nestál princ.\n\nStál tam tygr.\n\nŽivej.\n\nDivokej.\n\nObrovskej.\n\nOpravdickej.\n\n„Tohle není můj princ,“ řekla.",
      "characters": 123,
      "words": 17
    },
    {
      "id": "09",
      "label": "„Ne. Ale je to tvůj sen,“ řekla",
      "text": "„Ne. Ale je to tvůj sen,“ řekla myš, co zapisovala dějiny.\n\nA člověčice se rozmyslela.\n\n„Možná nebudu princeznou.\n\nMožná budu tou, co líbá tygry. “\n\nA žába — už ne žába —\n\nuž tygr —\n\nse usmál.",
      "characters": 192,
      "words": 33
    },
    {
      "id": "10",
      "label": "--- Tahle pohádka nemá konec. Protože přání",
      "text": "---\n\nTahle pohádka nemá konec.\n\nProtože přání nejsou ro\n\nvnice.\n\nA láska není tradice.\n\nJe to jazyk, co se mění podle toho, kdo mluví.",
      "characters": 134,
      "words": 23
    }
  ],
