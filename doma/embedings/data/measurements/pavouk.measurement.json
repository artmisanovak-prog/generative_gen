  "source_segments": [
    {
      "id": "01",
      "label": "PAVOUK který byl jen Jen Tak. Tak.",
      "text": "PAVOUK\n\nkterý byl jen Jen Tak. Tak.\n\nPavouk měl nitě.\n\nTenké, pevné, neviditelné.\n\nVěšel na ně věci.\n\nNe věci jako ponožky nebo klíče.\n\nAle věci, co se nedají držet.",
      "characters": 165,
      "words": 29
    },
    {
      "id": "02",
      "label": "Slova, co se neřekla. Pocity, co se",
      "text": "Slova, co se neřekla.\n\nPocity, co se nehodily.\n\nOtázky, co neměly odpověď.\n\nVšechno zůstalo viset.\n\nJen tak.\n\nTak.\n\nJedna věta visela mezi dvěma větvemi.",
      "characters": 153,
      "words": 24
    },
    {
      "id": "03",
      "label": "„Promiň, že jsem…“ A dál už nic.",
      "text": "„Promiň, že jsem…“\n\nA dál už nic.\n\nJen nit.\n\nJen ticho.\n\nJedna vzpomínka visela nad dveřmi.\n\nNa den, kdy se mělo něco stát, ale nestalo.\n\nA pořád tam byla.",
      "characters": 155,
      "words": 29
    },
    {
      "id": "04",
      "label": "Jako ozdoba, co nikdo nechtěl. Jedna omluva",
      "text": "Jako ozdoba, co nikdo nechtěl.\n\nJedna omluva visela těsně nad hlavou.\n\nTak nízko, že se jí dalo dotknout.\n\nAle nikdo to neudělal.\n\nProtože co kdyby spadla?\n\nPavouk seděl uprostřed.\n\nV srdci sítě.",
      "characters": 195,
      "words": 32
    },
    {
      "id": "05",
      "label": "A nehybal se. Protože když se hýbeš,",
      "text": "A nehybal se.\n\nProtože když se hýbeš, věci padají.\n\nA když padají, už je nikdo nezvedne.\n\n„Proč to nenecháš spadnout?“ zeptala se myš.\n\nTa, co si zapisuje ticho.\n\n„Protože když to visí, ještě to může být,“ řekl pavouk.",
      "characters": 218,
      "words": 38
    },
    {
      "id": "06",
      "label": "„A když to spadne?“ „Pak už je",
      "text": "„A když to spadne?“\n\n„Pak už je to jen minulost.“\n\nMyš si to poznamenala.\n\nDo mezery mezi slovy „jen“ a „tak“.\n\nA pak se zeptala:\n\n„A co když to visí moc dlouho?“\n\n„Pak to ztvrdne,“ řekl pavouk.",
      "characters": 194,
      "words": 37
    },
    {
      "id": "07",
      "label": "„A už to nejde rozmotat.“ Pavouk dál",
      "text": "„A už to nejde rozmotat.“\n\nPavouk dál věšel.\n\nJednu lásku, co se neřekla.\n\nJednu hádku, co se nevyřešila.\n\nJednu neděli, co se nikdy nestala.\n\nA jednu větu, co zněla:\n\n„To je v pohodě.“",
      "characters": 185,
      "words": 33
    },
    {
      "id": "08",
      "label": "Ale nebyla. Vítr přišel. Nenápadný. Ale přesný.",
      "text": "Ale nebyla.\n\nVítr přišel.\n\nNenápadný.\n\nAle přesný.\n\nZavál.\n\nA všechno se rozhoupalo.\n\nAle nic nespadlo.",
      "characters": 103,
      "words": 15
    },
    {
      "id": "09",
      "label": "„Všechno zůstalo viset,“ řekl pavouk. „Jen tak.“",
      "text": "„Všechno zůstalo viset,“ řekl pavouk.\n\n„Jen tak.“\n\n„Tak.“\n\nMyš se podívala nahoru.\n\nNa síť.\n\nNa věci, co visely.\n\nNa to, co se mělo stát, ale nestalo.",
      "characters": 150,
      "words": 26
    },
    {
      "id": "10",
      "label": "A řekla: „Možná je tohle ten největší",
      "text": "A řekla:\n\n„Možná je tohle ten největší pád. Když se nic nezmění.“\n\nPavouk se usmál.\n\nAle jen trochu.\n\nA zavěsil další věc.\n\nTentokrát ticho.",
      "characters": 140,
      "words": 24
    }
  ],
