  "segments": [
    {
      "id": "s01",
      "text": "Slon byl velký.\nTěžký.\nRozvážný.\nNosil v sobě paměť krajin, které už neexistují.\nKdyž šel, země se chvěla.\nKdyž stál, čas se zpomalil.",
      "chars": 134,
      "words": 15
    },
    {
      "id": "s02",
      "text": "A pak přišla ona.\nMalá.\nRychlá.\nNeuchopitelná.\nMožná myš.\nMožná vítr.\nMožná jen hlas.",
      "chars": 85,
      "words": 10
    },
    {
      "id": "s03",
      "text": "Slon se podíval na své nohy.\nNa zem.\nNa horizont.\nA pak se rozběhl.\nNe rychle.\nAle srdcem.",
      "chars": 90,
      "words": 9
    },
    {
      "id": "s04",
      "text": "Třešeň byla červená.\nLesklá.\nNedosažitelná.\nA slon běžel.\nZa chutí.\nZa slibem.\nZa něčím, co možná ani neexistuje.",
      "chars": 113,
      "words": 11
    },
    {
      "id": "s05",
      "text": "Cestou míjel stromy, které si ho pamatovaly.\nŘeky, které ho kdysi chladily.\nKamínky, které kdysi se mu smály.\nAle on běžel dál.\nPřestože třešeň byla jenom ovoce.",
      "chars": 161,
      "words": 16
    },
    {
      "id": "s06",
      "text": "Protože třešeň byla víc než ovoce.\nByla výzva.\nByla hra.\nByla touha být lehký.\nByla touha být silnější.",
      "chars": 103,
      "words": 12
    },
    {
      "id": "s07",
      "text": "„Jednu třešeň ti dám, slone,“ znělo pořád.\nAle nikdy ji nedostal.\nA právě proto běžel.\nAby nemohl zastavit.",
      "chars": 107,
      "words": 12
    },
    {
      "id": "s08",
      "text": "A tak se začalo říkat, že někde v krajině běží slon.\nZa třešní, kterou nikdy nedohoní.\nA že dokud se za ní požene, nikdy se nehoní.\nA že stačí běžet za něčím malým.\nA věřit, že to má velký smysl.",
      "chars": 195,
      "words": 21
    }
  ],
