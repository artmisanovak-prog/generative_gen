  "source_segments": [
    {
      "id": "01",
      "label": "O LIŠCE která byla z části —",
      "text": "O LIŠCE\n\nkterá byla z části\n\n—",
      "characters": 30,
      "words": 4
    },
    {
      "id": "02",
      "label": "Kdysi, v krajině, kde se stromy nenakláněly kvůli větru,",
      "text": "Kdysi, v krajině, kde se stromy nenakláněly kvůli větru, ale kvůli tíze slov, žila liška. Ne ta z dětských knížek, co krade slepice a směje se pod fousy. Tahle liška byla jiná. Tichá. Pozorující. A hlavně – celá.\n\n—",
      "characters": 215,
      "words": 33
    },
    {
      "id": "03",
      "label": "Měla kožich, který se leskl jako podzimní večer. Tlapky,",
      "text": "Měla kožich, který se leskl jako podzimní večer. Tlapky, které uměly chodit po sněhu, aniž by ho rušily. Oči, které viděly věci, co se ještě nestaly. A srdce – těžké, tvrdé, ale průzračné. Diamant. Velký. Ne pro parádu. Pro tíhu.\n\n—",
      "characters": 232,
      "words": 38
    },
    {
      "id": "04",
      "label": "Ale svět si všiml. A jakmile si svět všimne,",
      "text": "Ale svět si všiml. A jakmile si svět všimne, začne chtít.\n\n—\n\nPrvní přišli obchodníci. S měřítky, s cenami, s rukama připravenýma brát.\n\n„Ten kožich,“ řekli. „To je přesně ono. Luxus. Teplo. Lesk.“\n\nA tak lišce vzali srst.",
      "characters": 222,
      "words": 32
    },
    {
      "id": "05",
      "label": "Zůstala nahá. Ale ne slabá. Jen jiná. — Pak",
      "text": "Zůstala nahá. Ale ne slabá. Jen jiná.\n\n—\n\nPak přišli ti, co chodí v botách z hadí kůže. znají cestu. My chceme směr.“\n\nA tak jí vzali chodidla.\n\nZůstaly jí jen vzpomínky na stopy.\n\n—\n\nPotom přišli šperkaři. Ne pro krásu, ale pro sílu.",
      "characters": 234,
      "words": 39
    },
    {
      "id": "06",
      "label": "„Zuby z mrožoviny? Pche. Ale liščí zuby – to",
      "text": "„Zuby z mrožoviny? Pche. Ale liščí zuby – to je elegance s ostřím.“\n\nA tak jí vzali úsměv.\n\nZůstalo mlčení.\n\n—\n\nNakonec přišel někdo, kdo se neptal. Nepředstavil se. Jen sáhl do její hrudi a vytáhl srdce.\n\nByl to kámen. Diamant. Velký.",
      "characters": 235,
      "words": 36
    },
    {
      "id": "07",
      "label": "„Tohle je to nejcennější,“ řekl. A odešel. — A",
      "text": "„Tohle je to nejcennější,“ řekl.\n\nA odešel.\n\n—\n\nA liška?\n\nZůstala. Bez srsti. Bez tlapek. Bez smíchu. Bez srdce.\n\nAle pořád tam byla.\n\nNe jako zvíře. Jako stín. Jako paměť.\n\n—",
      "characters": 175,
      "words": 27
    },
    {
      "id": "08",
      "label": "Začala se pohybovat jinak. Ne kráčet – ale klouzat.",
      "text": "Začala se pohybovat jinak. Ne kráčet – ale klouzat. Ne mluvit – ale šeptat. Ne žít – ale být.\n\n—\n\nA v tom bytí se začalo něco dít.\n\nLidé, kteří si z ní vzali, začali ztrácet.\n\nKožich se rozpadl na chlupy, které se nedaly sešít.",
      "characters": 227,
      "words": 38
    },
    {
      "id": "09",
      "label": "Boty z hadí kůže se rozpadly na šupiny, které",
      "text": "Boty z hadí kůže se rozpadly na šupiny, které klouzaly z nohou.\n\nŠperky ze zubů se začaly třepit, jako by se smály těm, kdo je nosí.\n\nA diamant? Ten zčernal. Ne z špíny. Z pravdy.\n\n—\n\nProtože to, co se vezme násilím, se neudrží.\n\nA to, co se vezme z lišky, se nehodí nikomu jinému.\n\n—",
      "characters": 284,
      "words": 47
    },
    {
      "id": "10",
      "label": "Liška se mezitím stala legendo,u. Ne tou, co se",
      "text": "Liška se mezitím stala legendo,u.\n\nNe tou, co se vypráví dětem.\n\nTou, co se šeptá mezi stromy.\n\n„Viděli jste ji?“\n\n„Ne, ale cítili jsme ji.“\n\n„Jak?“\n\n„Jako ticho, které má tvar.“\n\n—\n\nA tak se začalo říkat, že někde běhá liška, která nemá nic – a právě proto má všechno.\n\n—\n\nJejí srdce je kámen.\n\nAle ne ten, co se nosí.\n\nTen, co se nese.",
      "characters": 337,
      "words": 60
    }
  ],
