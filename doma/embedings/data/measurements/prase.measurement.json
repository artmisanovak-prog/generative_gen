  "source_segments": [
    {
      "id": "01",
      "label": "Karta: doma/ilustrace/prase.jpg Text: tady není záchod? O PRASÁTKOVI které",
      "text": "Karta: doma/ilustrace/prase.jpg\n\nText: tady není záchod?\n\nO PRASÁTKOVI\n\nkteré hledá záchod\n\n(miniatura o drobných a drobném nedorozumění)\n\n„Tady není záchod?“\n\nzeptalo se prasátko.\n\nNahlas.",
      "characters": 189,
      "words": 24
    },
    {
      "id": "02",
      "label": "Uprostřed místnosti, kde se zrovna nikdo na nic neptal.",
      "text": "Uprostřed místnosti, kde se zrovna nikdo na nic neptal.\n\nA už vůbec ne na tohle.\n\nPáv se zarazil v půli věty.\n\nZebra přestala přežvykovat svůj vlastní vzor.",
      "characters": 156,
      "words": 25
    },
    {
      "id": "03",
      "label": "Opice ztuhla v pohybu, jako by jí někdo zmrazil",
      "text": "Opice ztuhla v pohybu, jako by jí někdo zmrazil banán v ruce.\n\nA někdo v rohu si nervózně odkašlal.\n\n„Promiňte,“ dodalo prasátko.\n\n„Já jen… jsem plné.“\n\nTicho.\n\nTicho, který se dá nakrájet.",
      "characters": 189,
      "words": 28
    },
    {
      "id": "04",
      "label": "Takové to ticho, co zadrží dech. Ticho, co se",
      "text": "Takové to ticho, co zadrží dech.\n\nTicho, co se tváří, že neslyšelo, ale všechno slyšelo.\n\n„Záchod?“\n\nřekl páv.\n\n„To je otázka na dámy.“\n\n„Já jsem dáma,“ řeklo prasátko.\n\n„Aspoň uvnitř. A možná i zespodu.“",
      "characters": 204,
      "words": 32
    },
    {
      "id": "05",
      "label": "Zebra se naklonila blíž. „A co vlastně jsi?“ „Prase?“",
      "text": "Zebra se naklonila blíž.\n\n„A co vlastně jsi?“\n\n„Prase?“\n\n„Pokladnička?“\n\n„Obojí,“ řeklo prasátko.\n\n„Plné. Ale nevím, jak tomu říkat, když chci ven.“\n\n„Chceš se vyprázdnit?“\n\nzeptala se opice.\n\n„To je faupaux.“",
      "characters": 209,
      "words": 30
    },
    {
      "id": "06",
      "label": "„To je potřeba,“ řeklo prasátko. „A mám drobný.“ A",
      "text": "„To je potřeba,“ řeklo prasátko.\n\n„A mám drobný.“\n\nA opravdu — když se pohnulo, cinklo to.\n\nNe moc.\n\nTak decentně.\n\nTak, že se člověk nemohl rozhodnout, jestli je to roztomilý, nebo nebo..nebo spíš není.",
      "characters": 203,
      "words": 32
    },
    {
      "id": "07",
      "label": "„Drobnýma se přece platí za záchod,“ řeklo prasátko. „Ale",
      "text": "„Drobnýma se přece platí za záchod,“ řeklo prasátko.\n\n„Ale záchod nikde.“\n\nA tak stálo.\n\nPlné.\n\nPřipravené.\n\nS otvorem na hřbetě a výrazem prosícím o pomoc, nebo aspoň pochopení.\n\nA pak se to stalo.\n\nNěkdo — nikdo neví kdo —\n\nnastavil dlaň.",
      "characters": 240,
      "words": 34
    },
    {
      "id": "08",
      "label": "Reflex. Instinkt. Možná soucit. Možná zvědavost. A prasátko se",
      "text": "Reflex.\n\nInstinkt.\n\nMožná soucit.\n\nMožná zvědavost.\n\nA prasátko se zaradovalo.\n\nJak jen se může zaradovat pokladnička.\n\nZacinkalo.\n\nA ulevilo si.\n\nDvě koruny.\n\nJedna padesátka.\n\nA něco, co mohlo být knoflík.\n\n„Děkuji,“ řeklo.\n\n„Už je to lepší?“",
      "characters": 244,
      "words": 33
    },
    {
      "id": "09",
      "label": "“Ano. To velmi pomohlo. Drobné si nechte,” Proneslo ještě",
      "text": "“Ano. To velmi pomohlo.\n\nDrobné si nechte,”\n\nProneslo ještě vychovaně.\n\nA všichni si oddechli.\n\nNe proto, že by to skončilo.\n\nAle protože nikdo u sebe neměl drobné zpátky.\n\nA pak už se nikdo neptal, jestli to bylo prase, nebo pokladnička.",
      "characters": 238,
      "words": 37
    },
    {
      "id": "10",
      "label": "Jestli to bylo čistý, nebo špinavý. Jestli to bylo",
      "text": "Jestli to bylo čistý, nebo špinavý.\n\nJestli to bylo trapný, nebo normální.\n\nProtože většina je faupaux jsou hlavně pravdy.\n\nA drobný jsou jen jinej druh přebytku\n\n.\n\nA záchod?\n\nTen se možná nikde nenajde.\n\nAle nastavená ruka?\n\nTa se najde vždycky",
      "characters": 246,
      "words": 38
    }
  ],
